 "uncertain": {
  "+1V1": "U4 is MIC5504 adjusted for 1.15 V (schematic note); nominal 1.1 V chosen over 1.2",
  "VCCRAM": "Normally tied to +3V3 via R54 (3.3 V); U15 1.8 V LDO is an alternate population option",
  "Net-(D27-K)": "common-source node of back-to-back PMOS Q1/Q2 (CONTROL->TARGET_A pass-through); ~5 V when on but floats with TARGET_A otherwise",
  "Net-(D28-K)": "common-source node of back-to-back PMOS Q4/Q5 (AUX<->TARGET_A); carries pass-through current, voltage follows VBUS",
  "Net-(D29-K)": "common-source node of back-to-back PMOS Q6/Q7 (TARGET_C<->TARGET_A); carries pass-through current",
  "/AUX Port/AUX PHY/VBUS_CLAMPED": "VBUS detect input to FUSB302B via 5.1k + 24V zener; sense-only, could be read as signal",
  "/AUX Port/AUX PHY/VBUS_SENSE": "USB3343 VBUS detect pin via 20k; sense-only, could be read as signal",
  "/TARGET Port/TARGET PHY/VBUS_CLAMPED": "VBUS detect input to FUSB302B; sense-only, could be signal",
  "/TARGET Port/TARGET PHY/VBUS_SENSE": "USB3343 VBUS detect; sense-only, could be signal",
  "/CONTROL Port/CONTROL PHY/VBUS_SENSE": "USB3343 VBUS detect; sense-only, could be signal",
  "Net-(U13-CB)": "DPO2036 charge-pump/bias cap on a CC/SBU protection switch (not a power-rail switch); power_control vs signal ambiguous",
  "Net-(U14-CB)": "same as U13-CB",
  "Net-(D9-A)": "TC_SWD (J10) pin 6 feeding +5V through Schottky D9: optional debug-header power input",
  "J10": "Tag-Connect SWD header; pin 6 can back-feed +5V via D9, so labelled power_input though mostly signals",
  "J4": "TARGET-C USB-C: host VBUS enters here but only passes through (Q6/Q7) to TARGET-A; it does not power the board rails",
  "J3": "TARGET-A USB-A: VBUS leaves the board to target device (pass-through/output)",
  "U13": "DPO2036 CC/SBU over-voltage protection IC: draws from +3V3 (load) but is functionally a protection part",
  "U14": "same as U13",
  "J11": "spring contacts to GND (chassis/EMI contact), labelled other (mechanical)",
  "/FPGA Banks 6 and 7/TARGET_A_DISCHARGE": "FPGA output driving VBUS discharge transistor; power_control vs signal",
  "AUX_VBUS": "AUX VBUS 4.4-21 V working range (5 V when used as power input); voltage unknown"
 }
