# --- KiCAD Prism Root Environment Variables ---
# Use this file as a template for your own .env file at the project root.
# docker-compose.yml passes every variable in this file to the backend and
# worker containers. When the file is not ./.env, pass it with --env-file and
# also set PRISM_ENV_FILE to the same path, for example:
#   PRISM_ENV_FILE=prod.env docker compose --env-file prod.env up -d

# ===========================================
# Authentication (OIDC/OAuth2 + RBAC)
# ===========================================
# Friendly workspace display name shown on the login page
WORKSPACE_NAME=KiCAD Prism

# Set to false to serve every request as an unauthenticated guest.
# This is the ONLY way to disable authentication. If it is true and no login
# method is complete (OIDC or PASSWORD_AUTH_ENABLED) or SESSION_SECRET is
# incomplete, the backend refuses to start rather than silently falling back
# to open access.
AUTH_ENABLED=true

# Role granted to the guest identity when AUTH_ENABLED=false. Raising this to
# "admin" gives every visitor import, edit, release and administration rights,
# with no login and no audit trail. The backend refuses to start with an admin
# guest on any PUBLIC_BASE_URL other than localhost.
DEV_GUEST_ROLE=viewer

# Required when AUTH_ENABLED=true, unless PASSWORD_AUTH_ENABLED=true below.
# For Google Sign-In, use:
#   OIDC_ISSUER_URL=https://accounts.google.com
#   OIDC_SCOPES=openid email profile
#   OIDC_EMAIL_CLAIM=email
#   OIDC_NAME_CLAIM=name
#   OIDC_PICTURE_CLAIM=picture
#   OIDC_PROVIDER_NAME=Google
#   OIDC_TOKEN_AUTH_METHOD=client_secret_post
# Other OIDC providers usually use the same claim names, but check their
# discovery/userinfo docs if email, name, or picture are mapped differently.
# If your provider requires HTTP Basic authentication at the token endpoint,
# set OIDC_TOKEN_AUTH_METHOD=client_secret_basic.
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPES=openid email profile
OIDC_EMAIL_CLAIM=email
OIDC_NAME_CLAIM=name
OIDC_PICTURE_CLAIM=picture
OIDC_PROVIDER_NAME=SSO
OIDC_TOKEN_AUTH_METHOD=client_secret_post

# Optional allowlist filters (leave empty to rely only on RBAC role assignments)
ALLOWED_USERS_STR=
ALLOWED_DOMAINS_STR=

# Bootstrap admins (comma-separated SSO account emails)
BOOTSTRAP_ADMIN_USERS_STR=admin@example.com

# Domains that receive implicit viewer access when no explicit RBAC role is set
# Leave empty to require explicit RBAC assignments for non-admin users.
# Example: DEFAULT_VIEWER_DOMAINS_STR=example.com,engineering.example.com
DEFAULT_VIEWER_DOMAINS_STR=

# Required: session signing secret for the HttpOnly auth cookie.
# Minimum 32 characters and genuinely random. Generate one with:
#   openssl rand -base64 48
SESSION_SECRET=

# Session lifetime in hours
SESSION_TTL_HOURS=12

# Revoke a session after this many minutes without use. 0 disables idle expiry.
SESSION_IDLE_TIMEOUT_MINUTES=0

# Cookie Secure flag. Leave unset to derive it from PUBLIC_BASE_URL, which is
# correct for both local HTTP and an HTTPS reverse proxy. Set explicitly only to
# override that.
# SESSION_COOKIE_SECURE=true

# Authentication attempts allowed per client per window, across all workers.
AUTH_LOGIN_RATE_LIMIT=10
AUTH_LOGIN_RATE_LIMIT_WINDOW_SECONDS=300

# Local email/password login. Off by default; OIDC remains the usual method.
# Password login never creates an account: assign a role in Settings first.
# There is no public signup and no mailer. Lost passwords are reset by an admin.
PASSWORD_AUTH_ENABLED=false
PASSWORD_MIN_LENGTH=12
SESSION_REMEMBER_ME_DAYS=30
# One-time password for BOOTSTRAP_ADMIN_USERS on first startup. They must change
# it at first sign-in. Leave empty once real accounts exist; Prism will not
# overwrite an existing password.
# BOOTSTRAP_ADMIN_PASSWORD=

# Browser origins allowed to make credentialed API calls.
# Keep this explicit; do not use "*" with session cookies.
# Local HTTP examples:
CORS_ORIGINS_STR=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:8080,http://localhost:8080
# Production HTTPS example (replace; do not keep localhost entries on shared hosts):
# CORS_ORIGINS_STR=https://prism.example.com
# COMMENTS_API_BASE_URL=https://prism.example.com
#
# Full HTTPS / internal-CA / KiCad trust guide:
#   https://krishna-swaroop.github.io/KiCAD-Prism/admin/deployment/
# Optional Compose TLS sidecar:
#   docker compose -f docker-compose.yml -f docker-compose.proxy.yml up --build -d

# Canonical public origin for Remote Symbols / OAuth and the comment WebSocket
# Origin allowlist behind a reverse proxy (example: https://prism.example.com).
# A shared deployment must set this or include its exact origin in
# CORS_ORIGINS_STR; forwarded headers never authorize cookie WebSockets.
# Other URL helpers can derive from X-Forwarded-* headers when this is empty.
PUBLIC_BASE_URL=

# Optional comments-only override (wins over PUBLIC_BASE_URL for comments helpers).
COMMENTS_API_BASE_URL=
PRISM_COMMENT_LIVE_ENABLED=true

# Local OAuth2 service-client tokens for PLM/MRP integrations
OAUTH_SERVICE_TOKEN_TTL_SECONDS=3600

# Optional external OAuth2/OIDC bearer JWT validation for machine clients
OAUTH_EXTERNAL_JWT_ISSUER_URL=
OAUTH_EXTERNAL_JWT_AUDIENCE=
OAUTH_EXTERNAL_JWT_ROLE_CLAIM=prism_role
OAUTH_EXTERNAL_JWT_SCOPES_CLAIM=scope
OAUTH_EXTERNAL_JWT_CLIENT_ID_CLAIM=client_id

# ===========================================
# KiCad Remote Symbol Provider
# ===========================================
# PostgreSQL is authoritative for workspace, comments, catalog, jobs, and
# artifact metadata. Compose supplies a private local default URL.
PRISM_DATABASE_URL=
POSTGRES_DB=kicad_prism
POSTGRES_USER=kicad_prism
POSTGRES_PASSWORD=
PRISM_DATABASE_POOL_MIN_SIZE=1
PRISM_DATABASE_POOL_MAX_SIZE=10
# Only relevant when PostgreSQL is not on this host. A NAT gateway or load
# balancer will drop an idle connection without telling either end; keep the
# keepalive idle period below its timeout so the kernel notices first.
PRISM_DATABASE_CONNECT_TIMEOUT_SECONDS=10
PRISM_DATABASE_KEEPALIVE_IDLE_SECONDS=30
PRISM_DATABASE_POOL_MAX_LIFETIME_SECONDS=1800
CATALOG_WORKER_CONCURRENCY=2
CATALOG_KICAD_CONCURRENCY=1
CATALOG_WORKER_POLL_SECONDS=1
CATALOG_JOB_LEASE_SECONDS=120
PRISM_WORKER_CONCURRENCY=4
# Memory (MiB) the prism worker admits heavy jobs against: bundle builds,
# comparisons, Release Studio builds, jobsets and simulations reserve their
# measured peak. Default: half the container's memory, clamped to 4-8 GiB.
# PRISM_WORKER_MEMORY_BUDGET_MIB=4096
PRISM_WORKER_POLL_SECONDS=0.5
PRISM_AUTO_SYNC_INTERVAL_SECONDS=300
# Hard ceiling for one project git fetch; git's low-speed abort stops a stalled
# transfer sooner.
PRISM_GIT_FETCH_TIMEOUT_SECONDS=300
PRISM_JOB_LEASE_SECONDS=30
PRISM_JOB_HEARTBEAT_SECONDS=10
PRISM_JOB_CANCEL_GRACE_SECONDS=10
PRISM_JOB_ARTIFACT_ROOT=
PRISM_JOB_ARTIFACT_RETENTION_DAYS=30
# Finished jobs (rows, events, log folders); still-referenced jobs are kept.
PRISM_JOB_RETENTION_DAYS=90
PRISM_ROUTINE_JOB_RETENTION_DAYS=7
PRISM_JOB_PARTIAL_RETENTION_HOURS=24
PRISM_DESIGN_COMPARE_CONCURRENCY=1
PRISM_WORKFLOW_CONCURRENCY=1
PRISM_IMPORT_CONCURRENCY=1
PRISM_SEMANTIC_COMPILE_SLOTS=2
# KiCad tools. Empty uses PATH (and, for kicad-cli, the usual install
# locations); the image has both on PATH. A set kicad-cli path is used as given.
KICAD_CLI_PATH=
# Design bundles (docs/architecture/adr-native-design-bundle.md). Every consumer
# reads the bundle (ADR §9.7 R1, F4c).
# Queue a bundle after every import and sync, and prebuild each branch's newest
# commits and every tagged commit, every project's HEAD first. Off: bundles are
# built on demand only, and comparisons of unbuilt commits take the cold path.
PRISM_DESIGN_BUNDLE_AUTO_BUILD=true
# Bundle builds at once, the prebuild's included. Each build also holds a
# PRISM_SEMANTIC_COMPILE_SLOTS slot, a PRISM_WORKER_CONCURRENCY slot and
# 2.25 GiB of the worker memory budget, and must fit the budget below: with the
# default stage caps, 2 needs PRISM_DESIGN_BUNDLE_MEMORY_BUDGET_BYTES of at least
# 15569256448 (14.5 GiB).
PRISM_DESIGN_BUNDLE_CONCURRENCY=1
PRISM_DESIGN_BUNDLE_RETENTION_DAYS=30
PRISM_DESIGN_BUNDLE_BACKFILL_INTERVAL_SECONDS=60
PRISM_DESIGN_BUNDLE_PREBUILD_COMMITS=10
PRISM_DESIGN_BUNDLE_REUSE_CANDIDATES=3
# CONCURRENCY x (largest stage cap + 1.25 GiB) must fit this budget.
PRISM_DESIGN_BUNDLE_MEMORY_BUDGET_BYTES=8589934592
# Unpacked-cache bounds (archives are never evicted by these): drop a cache
# after this many idle days, and cap the store and each project.
# PRISM_DESIGN_BUNDLE_CACHE_IDLE_DAYS=7
# PRISM_DESIGN_BUNDLE_CACHE_MAX_BYTES=4294967296
# PRISM_DESIGN_BUNDLE_CACHE_PROJECT_MAX_BYTES=1073741824
# Optional overrides; the defaults are cli-spec.md §7.2's.
# PRISM_DESIGN_BUNDLE_PARSE_MEMORY_BYTES=4294967296
# PRISM_DESIGN_BUNDLE_BOARD_MEMORY_BYTES=6442450944
# PRISM_DESIGN_BUNDLE_MODELS_MEMORY_BYTES=2147483648
# PRISM_DESIGN_BUNDLE_PARSE_TIMEOUT_MS=300000
# PRISM_DESIGN_BUNDLE_BOARD_TIMEOUT_MS=600000
# PRISM_DESIGN_BUNDLE_MODELS_TIMEOUT_MS=120000
# PRISM_DESIGN_BUNDLE_VERIFY_TIMEOUT_MS=300000
# PRISM_DESIGN_BUNDLE_THREADS=4
# PRISM_DESIGN_BUNDLE_MAX_ATTEMPTS=3
# Seconds a failed bundle stays failed before a status read queues it again (0: only Generate/Regenerate).
# PRISM_DESIGN_BUNDLE_FAILED_RETRY_SECONDS=3600
# PRISM_DESIGN_BUNDLE_GLB_TIMEOUT_SECONDS=600
# PRISM_DESIGN_BUNDLE_UPGRADE_TIMEOUT_SECONDS=900
# Host-only overrides; the image has prism-kicad on PATH, the store under
# KICAD_PROJECTS_ROOT/.kicad-prism/bundles, and the JSON Schema is read from
# native/contracts/generated/schema.
# PRISM_DESIGN_BUNDLE_CLI_PATH=/absolute/path/to/prism-kicad
# PRISM_DESIGN_BUNDLE_ROOT=
# PRISM_DESIGN_BUNDLE_SCHEMA_DIR=
# KiCad's Python (imports pcbnew) for the zone refill and board upgrades. Leave unset to find it:
# python.exe beside kicad-cli.exe on Windows, KiCad.app's Python on macOS, /usr/bin/python3 on Linux.
# PRISM_KICAD_PYTHON=
PRISM_ZONE_REFILL_TIMEOUT_SECONDS=900
PRISM_BACKEND_CPU_LIMIT=2.0
PRISM_BACKEND_MEMORY_LIMIT=4g
PRISM_WORKER_CPU_LIMIT=6.0
PRISM_WORKER_MEMORY_LIMIT=12g
CATALOG_WORKER_CPU_LIMIT=4.0
CATALOG_WORKER_MEMORY_LIMIT=8g
PRISM_WORKER_DATABASE_POOL_MAX_SIZE=6
PRISM_DESIGN_COMPARE_CACHE=
# Leave blank to use data/projects/.kicad-prism/artifacts.
CATALOG_ARTIFACT_ROOT=
# Files pasted or attached to review comments. Leave blank to use
# data/projects/.kicad-prism/comment-attachments.
COMMENT_ATTACHMENT_ROOT=
COMMENT_ATTACHMENT_MAX_BYTES=10485760
# Total attachment storage per project (bytes); 0 means no limit.
COMMENT_ATTACHMENT_PROJECT_QUOTA_BYTES=2147483648
# Signs image links in GitHub issues (backend and prism-worker share it):
# openssl rand -hex 32. Unset sends the file name instead of an image.
COMMENT_ATTACHMENT_LINK_SECRET=
COMMENT_ATTACHMENT_LINK_TTL_DAYS=365
CATALOG_RETENTION_ENABLED=true
# Days a superseded never-released draft STEP waits in quarantine before
# artifact maintenance deletes it (0 deletes it in the same run)
CATALOG_DRAFT_MODEL_QUARANTINE_DAYS=30
# Optional comma-separated name=/absolute/read-only/path folder import roots.
CATALOG_IMPORT_ROOTS=
CATALOG_IMPORT_MAX_FILES=100000
CATALOG_IMPORT_MAX_FILE_BYTES=2147483648
CATALOG_IMPORT_MAX_SNAPSHOT_BYTES=214748364800

# Generated CERN-style KiCad DBL bundle output. Leave blank to use:
#   data/projects/.kicad-prism/exports/kicad-dbl
CATALOG_DBL_EXPORT_DIR=

# Optional KiCad Library Convention validation for catalog health.
# When enabled, Prism runs kicad-library-utils check_symbol.py/check_footprint.py
# against attached symbol/footprint assets and stores durable validation reports.
CATALOG_KLC_ENABLED=true
CATALOG_KLC_UTILS_PATH=/opt/kicad-library-utils
# off = never affects release, warn = surface warnings but allow release,
# block = require current symbol/footprint assets to have non-failing KLC runs before release.
CATALOG_KLC_RELEASE_GATE=warn
CATALOG_KLC_TIMEOUT_SECONDS=30
CATALOG_KLC_SYMBOL_RULES=
CATALOG_KLC_SYMBOL_EXCLUDE_RULES=
CATALOG_KLC_FOOTPRINT_RULES=
CATALOG_KLC_FOOTPRINT_EXCLUDE_RULES=
CATALOG_KLC_FOOTPRINT_LIB_DIR=

# Local startup defaults. For an office/VPN workstation deployment, use 4-6
# workers on an 8-core host. Size the PostgreSQL pool so workers × max size stays
# below the database connection limit.
UVICORN_WORKERS=4
GIT_SCAN_KNOWN_HOSTS_ON_STARTUP=false

# Project import: restrict which Git hosts may be cloned from. Comma-separated
# hostnames; empty means any host. Prism always refuses remote-helper transports
# (ext::, fd::), file:// URLs, bare local paths, and credentials embedded in the
# URL, regardless of this setting.
IMPORT_ALLOWED_HOSTS_STR=

# Allow plaintext http:// clone URLs, for an internal Git server without TLS.
IMPORT_ALLOW_INSECURE_HTTP=false

# Public OAuth client id advertised to KiCad
REMOTE_PROVIDER_OAUTH_CLIENT_ID=kicad-prism-kicad

# Access token lifetime for KiCad provider auth
REMOTE_PROVIDER_ACCESS_TOKEN_TTL_SECONDS=3600

# Refresh token lifetime for KiCad provider auth
REMOTE_PROVIDER_REFRESH_TOKEN_TTL_SECONDS=604800

# Must match KiCad's Remote Symbols destination settings if you customize them
REMOTE_PROVIDER_LIBRARY_PREFIX=remote
# Use $${KIPRJMOD} in Compose env files so Docker does not interpolate it away.
REMOTE_PROVIDER_DESTINATION_DIR=$${KIPRJMOD}/RemoteLibrary
# Embed placed 3D models in the footprint so the board pins them (false ships
# every model to the destination directory instead)
REMOTE_PROVIDER_EMBED_3D_MODELS=true
# Compressed model bytes one placed footprint may embed (16 MiB); a model over
# it keeps the destination path
REMOTE_PROVIDER_EMBED_MAX_COMPRESSED_BYTES=16777216

# ===========================================
# Tracker integration (GitHub / GHES)
# ===========================================
# Root key for envelope-encrypted connector and OAuth credentials. Required
# before creating connectors or linking user accounts. Generate with:
#   openssl rand -hex 32
# Leave empty only when tracker integration is intentionally disabled.
TRACKER_CREDENTIAL_ROOT_KEY=
TRACKER_CREDENTIAL_ROOT_KEY_ID=v1
# During rotation, keep the previous key readable until all envelopes are
# re-wrapped, then clear these two variables.
# TRACKER_CREDENTIAL_PREVIOUS_ROOT_KEY=
# TRACKER_CREDENTIAL_PREVIOUS_ROOT_KEY_ID=
#
# PUBLIC_BASE_URL must be the HTTPS origin users and GitHub reach. It pins:
#   - user OAuth callback: /api/trackers/oauth/callback
#   - inbound webhooks:      /api/trackers/webhooks/github/{connectorId}
# Prism deep links embedded in promoted issues also use this origin.
#
# Operator guide: https://krishna-swaroop.github.io/KiCAD-Prism/admin/issue-trackers/

# ===========================================
# Supply
# ===========================================
# Currency a new workspace costs BOMs and compares prices in, as a three-letter
# code: EUR, USD, GBP, INR and every other currency with a European Central Bank
# rate. Administrators can change it later in Supply settings.
SUPPLY_BASE_CURRENCY=EUR

# ===========================================
# Git & Repository Access
# ===========================================
# GitHub PAT for private repository import/sync and Release publishing.
# Publishing a zip to a GitHub Release needs contents:write, not clone-only.
GITHUB_TOKEN=
# Read at image build time only (a BuildKit secret, never stored in the image):
# a GitHub token that can read krishna-swaroop/prism-sim-studio's releases, so
# the build installs the Simulation Studio engines pinned in
# backend/sim-engines.lock.json. Leave empty to build without them.
PRISM_SIM_RELEASE_TOKEN=
# Simulation Studio (experimental): the tab and its routes. Needs the engines
# above. See https://krishna-swaroop.github.io/KiCAD-Prism/use/simulation-studio/.
# PRISM_SIM_STUDIO_ENABLED=false
# More HTTPS Git credentials for import, sync and push, each sent only to
# remotes whose URL starts with its url_prefix (scheme, host, port, ending in
# "/"). Each token is read from the variable token_name names; set it here
# too. Add "username" where the server needs one (GitLab: "oauth2").
# GITHUB_TOKEN already covers https://github.com/. Release publishing uses
# PRISM_FORGE_HOSTS instead. See
# https://krishna-swaroop.github.io/KiCAD-Prism/admin/configuration/#git-credentials
# PRISM_GIT_CREDENTIALS=[{"url_prefix":"https://git.example.test/","token_name":"EXAMPLE_GIT_TOKEN"}]
# EXAMPLE_GIT_TOKEN=
PRISM_GIT_CREDENTIALS=
# GitLab token with api scope for Release publishing
GITLAB_TOKEN=
# Extra GitLab hosts for Release publishing. Legacy: host=gitlab,host=gitlab.
# Structured JSON supports per-host api_root and token_name; see
# https://krishna-swaroop.github.io/KiCAD-Prism/admin/configuration/#release-studio.
# github.com and gitlab.com are always included.
PRISM_FORGE_HOSTS=

# ===========================================
# Docker / KiCad runtime image
# ===========================================
# Source builds use the stable AMD64 base image pinned in backend/Dockerfile.
# Select another base image only with an explicit build-time --build-arg;
# image selection is not part of this runtime env file.
KICAD_BASE_PLATFORM=linux/amd64
DOCKER_PLATFORM=linux/amd64

# ===========================================
# Runtime / Development
# ===========================================
# Development affordances only. This no longer disables authentication; use
# AUTH_ENABLED=false for that.
DEV_MODE=false

# Design Comparison revision workers. Stage-specific values override the
# shared fallback. Use 1 for lower peak memory or 2 for lowest latency.
PRISM_DESIGN_COMPARE_MAX_REVISION_WORKERS=2
PRISM_DESIGN_COMPARE_MAX_INITIAL_WORKERS=2
PRISM_DESIGN_COMPARE_MAX_PCB_WORKERS=2
