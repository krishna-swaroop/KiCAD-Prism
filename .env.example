# --- KiCAD Prism Root Environment Variables ---
# Use this file as a template for your own .env file at the project root.
# These variables are consumed by docker-compose and passed into backend/frontend.

# ===========================================
# Authentication (OIDC/OAuth2 + RBAC)
# ===========================================
# Friendly workspace display name shown on the login page
WORKSPACE_NAME=KiCAD Prism

# Set to false to serve every request as an unauthenticated guest.
# This is the ONLY way to disable authentication. If it is true and the OIDC or
# SESSION_SECRET settings below are incomplete, the backend refuses to start
# rather than silently falling back to open access.
AUTH_ENABLED=true

# Role granted to the guest identity when AUTH_ENABLED=false. Raising this to
# "admin" gives every visitor import, edit, release and administration rights,
# with no login and no audit trail. The backend refuses to start with an admin
# guest on any PUBLIC_BASE_URL other than localhost.
DEV_GUEST_ROLE=viewer

# Required when AUTH_ENABLED=true.
# For Google Sign-In, use:
#   OIDC_ISSUER_URL=https://accounts.google.com
#   OIDC_SCOPES=openid email profile
#   OIDC_EMAIL_CLAIM=email
#   OIDC_NAME_CLAIM=name
#   OIDC_PICTURE_CLAIM=picture
#   OIDC_PROVIDER_NAME=Google
#   OIDC_TOKEN_AUTH_METHOD=client_secret_post
# Other OIDC providers usually use the same claim names, but check their
# discovery/userinfo docs if email, name, or picture are mapped differently.
# If your provider requires HTTP Basic authentication at the token endpoint,
# set OIDC_TOKEN_AUTH_METHOD=client_secret_basic.
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPES=openid email profile
OIDC_EMAIL_CLAIM=email
OIDC_NAME_CLAIM=name
OIDC_PICTURE_CLAIM=picture
OIDC_PROVIDER_NAME=SSO
OIDC_TOKEN_AUTH_METHOD=client_secret_post

# Optional allowlist filters (leave empty to rely only on RBAC role assignments)
ALLOWED_USERS_STR=
ALLOWED_DOMAINS_STR=

# Bootstrap admins (comma-separated SSO account emails)
BOOTSTRAP_ADMIN_USERS_STR=admin@example.com

# Domains that receive implicit viewer access when no explicit RBAC role is set
# Leave empty to require explicit RBAC assignments for non-admin users.
# Example: DEFAULT_VIEWER_DOMAINS_STR=example.com,engineering.example.com
DEFAULT_VIEWER_DOMAINS_STR=

# Required: session signing secret for the HttpOnly auth cookie.
# Minimum 32 characters and genuinely random. Generate one with:
#   openssl rand -base64 48
SESSION_SECRET=

# Session lifetime in hours
SESSION_TTL_HOURS=12

# Revoke a session after this many minutes without use. 0 disables idle expiry.
SESSION_IDLE_TIMEOUT_MINUTES=0

# Cookie Secure flag. Leave unset to derive it from PUBLIC_BASE_URL, which is
# correct for both local HTTP and an HTTPS reverse proxy. Set explicitly only to
# override that.
# SESSION_COOKIE_SECURE=true

# Authentication attempts allowed per client per window, across all workers.
AUTH_LOGIN_RATE_LIMIT=10
AUTH_LOGIN_RATE_LIMIT_WINDOW_SECONDS=300

# Browser origins allowed to make credentialed API calls.
# Keep this explicit; do not use "*" with session cookies.
# Local HTTP examples:
CORS_ORIGINS_STR=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:8080,http://localhost:8080
# Production HTTPS example (replace; do not keep localhost entries on shared hosts):
# CORS_ORIGINS_STR=https://prism.example.com
# COMMENTS_API_BASE_URL=https://prism.example.com
#
# Full HTTPS / internal-CA / KiCad trust guide:
#   docs/DEPLOYMENT.md
# Optional Compose TLS sidecar:
#   docker compose -f docker-compose.yml -f docker-compose.proxy.yml up --build -d

# Canonical public origin for Remote Symbols / OAuth absolute URLs behind a
# reverse proxy (example: https://prism.example.com). Leave empty to derive
# from X-Forwarded-* headers or the incoming request.
PUBLIC_BASE_URL=

# Optional comments-only override (wins over PUBLIC_BASE_URL for comments helpers).
COMMENTS_API_BASE_URL=

# Local OAuth2 service-client tokens for PLM/MRP integrations
OAUTH_SERVICE_TOKEN_TTL_SECONDS=3600

# Optional external OAuth2/OIDC bearer JWT validation for machine clients
OAUTH_EXTERNAL_JWT_ISSUER_URL=
OAUTH_EXTERNAL_JWT_AUDIENCE=
OAUTH_EXTERNAL_JWT_ROLE_CLAIM=prism_role
OAUTH_EXTERNAL_JWT_SCOPES_CLAIM=scope
OAUTH_EXTERNAL_JWT_CLIENT_ID_CLAIM=client_id

# ===========================================
# KiCad Remote Symbol Provider
# ===========================================
# PostgreSQL is authoritative for workspace, comments, catalog, jobs, and
# artifact metadata. Compose supplies a private local default URL.
PRISM_DATABASE_URL=
POSTGRES_DB=kicad_prism
POSTGRES_USER=kicad_prism
POSTGRES_PASSWORD=
PRISM_DATABASE_POOL_MIN_SIZE=1
PRISM_DATABASE_POOL_MAX_SIZE=10
# Only relevant when PostgreSQL is not on this host. A NAT gateway or load
# balancer will drop an idle connection without telling either end; keep the
# keepalive idle period below its timeout so the kernel notices first.
PRISM_DATABASE_CONNECT_TIMEOUT_SECONDS=10
PRISM_DATABASE_KEEPALIVE_IDLE_SECONDS=30
PRISM_DATABASE_POOL_MAX_LIFETIME_SECONDS=1800
CATALOG_WORKER_CONCURRENCY=2
CATALOG_KICAD_CONCURRENCY=1
CATALOG_WORKER_POLL_SECONDS=1
CATALOG_JOB_LEASE_SECONDS=120
PRISM_WORKER_CONCURRENCY=4
PRISM_WORKER_POLL_SECONDS=0.5
PRISM_JOB_LEASE_SECONDS=30
PRISM_JOB_HEARTBEAT_SECONDS=10
PRISM_JOB_CANCEL_GRACE_SECONDS=10
PRISM_JOB_ARTIFACT_ROOT=
PRISM_JOB_ARTIFACT_RETENTION_DAYS=30
PRISM_JOB_PARTIAL_RETENTION_HOURS=24
PRISM_WEBGPU_CONCURRENCY=1
PRISM_DESIGN_COMPARE_CONCURRENCY=1
PRISM_WORKFLOW_CONCURRENCY=1
PRISM_IMPORT_CONCURRENCY=1
PRISM_SEMANTIC_COMPILE_SLOTS=2
PRISM_BACKEND_CPU_LIMIT=2.0
PRISM_BACKEND_MEMORY_LIMIT=4g
PRISM_WORKER_CPU_LIMIT=6.0
PRISM_WORKER_MEMORY_LIMIT=12g
PRISM_WORKER_DATABASE_POOL_MAX_SIZE=6
PRISM_DESIGN_COMPARE_CACHE=
PRISM_SEMANTIC_VIEWER_CACHE=
# Leave blank to use data/projects/.kicad-prism/artifacts.
CATALOG_ARTIFACT_ROOT=
CATALOG_RETENTION_ENABLED=true
# Optional comma-separated name=/absolute/read-only/path folder import roots.
CATALOG_IMPORT_ROOTS=
CATALOG_IMPORT_MAX_FILES=100000
CATALOG_IMPORT_MAX_FILE_BYTES=2147483648
CATALOG_IMPORT_MAX_SNAPSHOT_BYTES=214748364800

# Generated CERN-style KiCad DBL bundle output. Leave blank to use:
#   data/projects/.kicad-prism/exports/kicad-dbl
CATALOG_DBL_EXPORT_DIR=

# Optional KiCad Library Convention validation for catalog health.
# When enabled, Prism runs kicad-library-utils check_symbol.py/check_footprint.py
# against attached symbol/footprint assets and stores durable validation reports.
CATALOG_KLC_ENABLED=true
CATALOG_KLC_UTILS_PATH=/opt/kicad-library-utils
# off = never affects release, warn = surface warnings but allow release,
# block = require current symbol/footprint assets to have non-failing KLC runs before release.
CATALOG_KLC_RELEASE_GATE=warn
CATALOG_KLC_TIMEOUT_SECONDS=30
CATALOG_KLC_SYMBOL_RULES=
CATALOG_KLC_SYMBOL_EXCLUDE_RULES=
CATALOG_KLC_FOOTPRINT_RULES=
CATALOG_KLC_FOOTPRINT_EXCLUDE_RULES=
CATALOG_KLC_FOOTPRINT_LIB_DIR=

# Local startup defaults. For an office/VPN workstation deployment, use 4-6
# workers on an 8-core host. Size the PostgreSQL pool so workers × max size stays
# below the database connection limit.
UVICORN_WORKERS=4
GIT_SCAN_KNOWN_HOSTS_ON_STARTUP=false

# Project import: restrict which Git hosts may be cloned from. Comma-separated
# hostnames; empty means any host. Prism always refuses remote-helper transports
# (ext::, fd::), file:// URLs, bare local paths, and credentials embedded in the
# URL, regardless of this setting.
IMPORT_ALLOWED_HOSTS_STR=

# Allow plaintext http:// clone URLs, for an internal Git server without TLS.
IMPORT_ALLOW_INSECURE_HTTP=false

# Public OAuth client id advertised to KiCad
REMOTE_PROVIDER_OAUTH_CLIENT_ID=kicad-prism-kicad

# Access token lifetime for KiCad provider auth
REMOTE_PROVIDER_ACCESS_TOKEN_TTL_SECONDS=3600

# Refresh token lifetime for KiCad provider auth
REMOTE_PROVIDER_REFRESH_TOKEN_TTL_SECONDS=604800

# Must match KiCad's Remote Symbols destination settings if you customize them
REMOTE_PROVIDER_LIBRARY_PREFIX=remote
# Use $${KIPRJMOD} in Compose env files so Docker does not interpolate it away.
REMOTE_PROVIDER_DESTINATION_DIR=$${KIPRJMOD}/RemoteLibrary

# ===========================================
# Git & Repository Access
# ===========================================
# Optional: GitHub PAT for private repository import/sync
GITHUB_TOKEN=

# ===========================================
# Docker / KiCad runtime image
# ===========================================
# Stable public AMD64 image. The digest pins the exact KiCad 10.0.4 runtime
# used by source builds and future Prism release images.
KICAD_BASE_IMAGE=kicad/kicad:10.0.4@sha256:ee71e88396f8563168eb1ef282cda9ff2670fe86a677c63dd78b35e3d464454c
KICAD_BASE_PLATFORM=linux/amd64
DOCKER_PLATFORM=linux/amd64

# ===========================================
# Runtime / Development
# ===========================================
# Development affordances only. This no longer disables authentication; use
# AUTH_ENABLED=false for that.
DEV_MODE=false

# Design Comparison revision workers. Stage-specific values override the
# shared fallback. Use 1 for lower peak memory or 2 for lowest latency.
PRISM_DESIGN_COMPARE_MAX_REVISION_WORKERS=2
PRISM_DESIGN_COMPARE_MAX_INITIAL_WORKERS=2
PRISM_DESIGN_COMPARE_MAX_PCB_WORKERS=2

# ===========================================
# Shared Machine Deployment
# ===========================================
# Persistent data locations. Point these elsewhere if the repo checkout isn't
# where you want data stored, e.g. when multiple deployments share one
# machine, or on a PaaS (Coolify, etc.) with its own storage convention.
# Kept as two separate full-path variables rather than one root + suffix:
# some platforms auto-detect docker-compose volumes and only handle a bind
# source that is a single complete ${VAR:-default} expression, not one with
# a path segment appended after it - see docs/DEPLOYMENT.md.
PROJECTS_DATA_DIR=./data/projects
SSH_DATA_DIR=./data/ssh

# Host-side published ports. These only change which port is exposed on the
# host; the containers still listen internally on 8000 (backend) and 80
# (frontend). Adjust if the defaults conflict with another service.
# To skip publishing ports entirely (e.g. behind a reverse proxy on a shared
# host), run with the docker-compose.no-ports.yml overlay instead - see
# docs/DEPLOYMENT.md.
BACKEND_PORT=8000
FRONTEND_PORT=8080
