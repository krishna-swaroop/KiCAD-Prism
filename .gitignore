# Common
.DS_Store
.vscode/

# Environment Files
.env
#.env.example

# Backend
**/__pycache__/
backend/**/*.pyc
backend/.env
backend/venv/
backend/app/static/remote_provider/

# Frontend
# Unanchored so it also catches a stray root-level node_modules, which vitest
# creates for its .vite cache when run from the repo root.
node_modules/
frontend/dist/
frontend/.env.local
# frontend/.env.example
frontend/.env 
frontend/.env.development.local
frontend/.env.test.local
frontend/.env.production.local
frontend/npm-debug.log*
frontend/yarn-debug.log*
frontend/yarn-error.log*
dist/

# Local Compose development overrides
docker-compose.override.yml

# Deployment installer output: contains .env with live secrets
generated/
generated.bak.*/

# Remote-panel loadtest secrets + reports
loadtest/.env.loadtest
loadtest/results/

# Python packaging + tooling artifacts
*.egg-info/
build/
.pytest_cache/

# Project Data
# (The project database is currently outside the repo, but just in case)
project-database/
data/

# Deploy: track Caddy/Nginx examples; ignore private certificate material
deploy/certs/*
!deploy/certs/README.md
!deploy/certs/.gitignore
*.key
*.pem
*.crt
