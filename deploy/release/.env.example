# The release workflow replaces these placeholders with immutable image digests.
PRISM_BACKEND_IMAGE=__PRISM_BACKEND_IMAGE__
PRISM_FRONTEND_IMAGE=__PRISM_FRONTEND_IMAGE__
PRISM_POSTGRES_IMAGE=postgres:17-alpine
PRISM_CADDY_IMAGE=caddy:2

PRISM_RELEASE=__PRISM_VERSION__
PRISM_REVISION=__PRISM_REVISION__
PRISM_BUILD_DATE=__PRISM_BUILD_DATE__
PRISM_HTTP_PORT=8080

# Authentication is required for shared deployments.
AUTH_ENABLED=true
# Used only when AUTH_ENABLED=false for a private local evaluation. "admin"
# gives every visitor full control and is refused on a non-local base URL.
DEV_GUEST_ROLE=viewer
WORKSPACE_NAME=KiCAD Prism
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPES=openid profile email
OIDC_EMAIL_CLAIM=email
OIDC_NAME_CLAIM=name
OIDC_PICTURE_CLAIM=picture
OIDC_PROVIDER_NAME=SSO
OIDC_TOKEN_AUTH_METHOD=client_secret_post
BOOTSTRAP_ADMIN_USERS_STR=
DEFAULT_VIEWER_DOMAINS_STR=
ALLOWED_USERS_STR=
ALLOWED_DOMAINS_STR=

# Generate with: openssl rand -base64 48
SESSION_SECRET=
SESSION_TTL_HOURS=12
SESSION_IDLE_TIMEOUT_MINUTES=0
# Leave unset to derive this from PUBLIC_BASE_URL. Set it explicitly only when
# an external proxy terminates HTTPS without a matching HTTPS public URL.
# SESSION_COOKIE_SECURE=true

# Local email/password login (off by default). Password login never creates an
# account; assign a role in Settings first. Lost passwords are reset by an admin.
PASSWORD_AUTH_ENABLED=false
PASSWORD_MIN_LENGTH=12
SESSION_REMEMBER_ME_DAYS=30
# BOOTSTRAP_ADMIN_PASSWORD=

PUBLIC_BASE_URL=
CORS_ORIGINS_STR=http://127.0.0.1:8080,http://localhost:8080
COMMENTS_API_BASE_URL=

POSTGRES_DB=kicad_prism
POSTGRES_USER=kicad_prism
POSTGRES_PASSWORD=
PRISM_DATABASE_POOL_MIN_SIZE=1
PRISM_DATABASE_POOL_MAX_SIZE=10
# Only relevant when PostgreSQL is not on this host. A NAT gateway or load
# balancer will drop an idle connection without telling either end; keep the
# keepalive idle period below its timeout so the kernel notices first.
PRISM_DATABASE_CONNECT_TIMEOUT_SECONDS=10
PRISM_DATABASE_KEEPALIVE_IDLE_SECONDS=30
PRISM_DATABASE_POOL_MAX_LIFETIME_SECONDS=1800

GITHUB_TOKEN=
GITLAB_TOKEN=
GIT_SCAN_KNOWN_HOSTS_ON_STARTUP=false
IMPORT_ALLOWED_HOSTS_STR=
IMPORT_ALLOW_INSECURE_HTTP=false

UVICORN_WORKERS=4
PRISM_BACKEND_CPU_LIMIT=2.0
PRISM_BACKEND_MEMORY_LIMIT=4g
PRISM_WORKER_CPU_LIMIT=4.0
PRISM_WORKER_MEMORY_LIMIT=12g
PRISM_WORKER_DATABASE_POOL_MAX_SIZE=6
CATALOG_WORKER_CPU_LIMIT=4.0
CATALOG_WORKER_MEMORY_LIMIT=8g
CATALOG_WORKER_DATABASE_POOL_MAX_SIZE=4

PRISM_WORKER_CONCURRENCY=4
PRISM_WORKER_POLL_SECONDS=0.5
CATALOG_WORKER_CONCURRENCY=2
CATALOG_KICAD_CONCURRENCY=1
CATALOG_WORKER_POLL_SECONDS=1
PRISM_WEBGPU_CONCURRENCY=1
PRISM_DESIGN_COMPARE_CONCURRENCY=1
PRISM_WORKFLOW_CONCURRENCY=1
PRISM_IMPORT_CONCURRENCY=1
PRISM_SEMANTIC_COMPILE_SLOTS=2

CATALOG_KLC_ENABLED=true
CATALOG_KLC_RELEASE_GATE=warn
CATALOG_RETENTION_ENABLED=true

REMOTE_PROVIDER_OAUTH_CLIENT_ID=kicad-prism-kicad
REMOTE_PROVIDER_ACCESS_TOKEN_TTL_SECONDS=3600
REMOTE_PROVIDER_REFRESH_TOKEN_TTL_SECONDS=604800
REMOTE_PROVIDER_LIBRARY_PREFIX=remote
REMOTE_PROVIDER_DESTINATION_DIR=$${KIPRJMOD}/RemoteLibrary
