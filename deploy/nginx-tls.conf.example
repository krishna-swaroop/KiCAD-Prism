# Example external Nginx TLS terminator for KiCAD Prism.
# Place this on the host or in a separate proxy container.
# Upstream "prism_frontend" should resolve to the Compose frontend
# (container name "frontend" on the Compose network, or host port 8080).

upstream prism_frontend {
    server frontend:80;
    # Or from the host network:
    # server 127.0.0.1:8080;
}

server {
    listen 80;
    server_name kicad-prism.corp.internal;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name kicad-prism.corp.internal;

    # Internal CA-issued leaf (+ chain if required by your Nginx build)
    ssl_certificate     /etc/nginx/certs/prism.crt;
    ssl_certificate_key /etc/nginx/certs/prism.key;

    # Modern baseline; adjust to corporate policy
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;

    client_max_body_size 2g;
    client_body_timeout 3600s;

    location / {
        proxy_pass http://prism_frontend;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host  $host;
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        $connection_upgrade;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
        proxy_request_buffering off;
    }
}

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}
